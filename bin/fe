#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# shellcheck source=../lib/runtime.sh
source "${ROOT}/lib/runtime.sh"

query="${1:-}"

# once workstation is instailled, we can swap out these lines
# preview_command="render_preview {}"
preview_command="${ROOT}/bin/render-preview {}"

file="$(
    fzf \
        --query="${query}" \
        --multi \
        --select-1 \
        --exit-0 \
        --preview "${preview_command}"
)"

[[ -n "${file}" ]] || exit 0

open_editor "${file}"