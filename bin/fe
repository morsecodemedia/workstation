#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# shellcheck source=../lib/runtime.sh
source "${ROOT}/lib/runtime.sh"

query="${1:-}"

preview_command=""

if command -v batcat >/dev/null 2>&1; then
    preview_command="batcat --theme Dracula --color=always {}"
elif command -v bat >/dev/null 2>&1; then
    preview_command="bat --theme Dracula --color=always {}"
fi

if [[ -n "${preview_command}" ]]; then

    file="$(
        fzf \
            --query="${query}" \
            --multi \
            --select-1 \
            --exit-0 \
            --preview "${preview_command}"
    )"

else

    file="$(
        fzf \
            --query="${query}" \
            --multi \
            --select-1 \
            --exit-0
    )"

fi

[[ -n "${file}" ]] || exit 0

open_editor "${file}"